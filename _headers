# Cloudflare static-asset headers (read at deploy, not served).
# Fonts never change in place: give a changed font a new file name, since browsers keep it for a year.
# Everything else keeps its file name across edits, so it gets a short cache only. HTML keeps Cloudflare's default (always revalidate).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=86400
/*.png
  Cache-Control: public, max-age=86400
/*.jpg
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400

# CSS/JS/icon sprite change together with the HTML, so only 5 minutes.
/*.css
  Cache-Control: public, max-age=300
/*.js
  Cache-Control: public, max-age=300
/icons.svg
  Cache-Control: public, max-age=300

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
